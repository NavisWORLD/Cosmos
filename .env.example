# COSMOS local runtime. Do not commit real credentials.
COSMOS_DATA_DIR=var
COSMOS_HOST=127.0.0.1
COSMOS_PORT=8081
COSMOS_BACKEND=echo
COSMOS_MEMORY_LIMIT=8

# Optional local Ollama backend
COSMOS_OLLAMA_URL=http://127.0.0.1:11434
COSMOS_OLLAMA_MODEL=qwen2.5:1.5b

# External quantum providers are intentionally not required by core.
# Add provider credentials only in your local .env, never here.
